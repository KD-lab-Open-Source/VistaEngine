# Write vista_version.h: the version this build reports, and the engine commit it was
# built from.
#
# Invoked at build time by the VistaVersionHeader target in the root CMakeLists.txt:
#   cmake -DOUT_HEADER=... -DVERSION=1.2.0 -DBUILD_NUMBER=57
#         -DGIT_EXECUTABLE=... -DSOURCE_DIR=... -P VistaVersion.cmake
#
# Inputs:
#   OUT_HEADER     : output .h path
#   VERSION        : MAJOR.MINOR.PATCH[-prerelease], validated at configure time
#   BUILD_NUMBER   : integer
#   GIT_EXECUTABLE : git, or empty when there is none -- the revision is then "unknown"
#   SOURCE_DIR     : the engine checkout to read the revision from
#
# file(CONFIGURE) only rewrites the header when its contents change, which is what
# keeps a build that moved no commit from recompiling anything.

set(REVISION "unknown")
if(GIT_EXECUTABLE)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --short=8 HEAD
        OUTPUT_VARIABLE _rev
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE _rc)
    if(_rc EQUAL 0 AND _rev)
        set(REVISION "${_rev}")
        # Tracked files only: a build tree or GameData sitting untracked in the
        # checkout does not make it a different engine.
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=no
            OUTPUT_VARIABLE _changes
            ERROR_QUIET)
        if(_changes)
            string(APPEND REVISION "-dirty")
        endif()
    endif()
endif()

string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)" _ "${VERSION}")
set(MAJOR ${CMAKE_MATCH_1})
set(MINOR ${CMAKE_MATCH_2})
set(PATCH ${CMAKE_MATCH_3})

file(CONFIGURE OUTPUT "${OUT_HEADER}" @ONLY CONTENT [[
// Generated by cmake/VistaVersion.cmake at build time. Do not edit.
// Plain #defines only, so a Windows .rc can include it for its VERSIONINFO.
#ifndef VISTA_VERSION_H
#define VISTA_VERSION_H

#define VISTA_VERSION_MAJOR  @MAJOR@
#define VISTA_VERSION_MINOR  @MINOR@
#define VISTA_VERSION_PATCH  @PATCH@
#define VISTA_BUILD_NUMBER   @BUILD_NUMBER@

// "1.2.0", "1.2.0-beta.3"; "0.0.0-dev" for a developer build
#define VISTA_VERSION_STRING "@VERSION@"
// The engine commit, with "-dirty" when built from uncommitted changes
#define VISTA_REVISION       "@REVISION@"
// "1.2.0+57.74db6a6e": the version, then which build of it (SemVer build metadata)
#define VISTA_VERSION_FULL   "@VERSION@+@BUILD_NUMBER@.@REVISION@"

#endif
]])
